							"            pm.expect(jsonData.total_amount).to.not.be.null;",
							"            pm.expect(jsonData.total_vat_amount).to.not.be.null;",
							"            pm.expect(jsonData.receipt_status).to.not.be.empty;",
							"            pm.expect(jsonData.merchant_transaction_id).to.not.be.empty;",
							"            pm.expect(jsonData.currency).to.not.be.empty;",
							"        } catch (e) {",
							"            console.error(\"Failed to parse JSON: \", e);",
							"        }",
							"    } else {",
							"        console.log(\"Request body is not in raw JSON format.\");",
							"    }",
							"});",
							"",
							"pm.test(\"Response body includes status and message properties\", () => {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('status');",
							"    pm.expect(jsonData).to.have.property('message');",
							"});",
							"",
							"pm.test(\"Response status code is 201\", function () {",
							"    pm.expect(pm.response.code).to.equal(201);",
							"});",
							"",
							"pm.test(\"Response body includes status and message properties\", function () {",
							"  const responseData = pm.response.json();",
							"  ",
							"  pm.expect(responseData).to.be.an('object');",
							"  pm.expect(responseData).to.include.all.keys('status', 'message');",
							"});",
							"",
							"",
							"pm.test(\"Response body has the correct schema\", function () {",
							"    const responseData = pm.response.json();",
							"    ",
							"    pm.expect(responseData).to.be.an('object');",
							"    pm.expect(responseData).to.have.property('status').that.is.a('string');",
							"    pm.expect(responseData).to.have.property('message').that.is.a('string');",
							"});",
							"",
							"pm.test(\"Ensure the response includes required fields - status and message\", function () {",
							"    const responseData = pm.response.json();",
							"    ",
							"    pm.expect(responseData).to.be.an('object');",
							"    pm.expect(responseData).to.have.property('status');",
							"    pm.expect(responseData).to.have.property('message');",
							"});",
							"",
							"// Test to check for specific response header fields",
							"pm.test(\"Response headers contain specific fields\", function () {",
							"    pm.response.to.have.header(\"Content-Type\");",
							"    pm.response.to.have.header(\"Date\");",
							"    pm.response.to.have.header(\"Content-Length\");",
							"    pm.response.to.have.header(\"location\");",
							"});"
